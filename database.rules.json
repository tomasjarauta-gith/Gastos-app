{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
        "data": {
          "config": {
            ".validate": "newData.hasChildren(['name1','name2','income1','income2'])",
            "name1": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "name2": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "groupName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "income1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
            },
            "income2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
            },
            "$other": {
              ".validate": false
            }
          },
          "expenses": {
            "$id": {
              ".validate": "$id.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['name','amount','date','paidBy','splitType','settled','ts'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000000"
              },
              "date": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              },
              "paidBy": {
                ".validate": "newData.val() == 'p1' || newData.val() == 'p2'"
              },
              "splitType": {
                ".validate": "newData.val() == 'equal' || newData.val() == 'proportional'"
              },
              "settled": {
                ".validate": "newData.isBoolean()"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "history": {
            "$id": {
              ".validate": "newData.hasChildren(['date','ts','amount','expenseCount','total'])",
              "date": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
              },
              "expenseCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
              },
              "total": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
              },
              "debtorName": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "sharedSpaces": {
          "$space": {
            ".validate": "newData.val() == true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "spaces": {
      "$owner": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && (auth.uid == $owner || root.child('spaces').child($owner).child('partner/uid').val() == auth.uid)",
        "data": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && (auth.uid == $owner || root.child('spaces').child($owner).child('partner/uid').val() == auth.uid)",
          "config": {
            ".validate": "newData.hasChildren(['name1','name2','income1','income2'])",
            "name1": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "name2": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "groupName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "income1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
            },
            "income2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
            },
            "$other": {
              ".validate": false
            }
          },
          "expenses": {
            "$id": {
              ".validate": "$id.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['name','amount','date','paidBy','splitType','settled','ts'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000000"
              },
              "date": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              },
              "paidBy": {
                ".validate": "newData.val() == 'p1' || newData.val() == 'p2'"
              },
              "splitType": {
                ".validate": "newData.val() == 'equal' || newData.val() == 'proportional'"
              },
              "settled": {
                ".validate": "newData.isBoolean()"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "history": {
            "$id": {
              ".validate": "newData.hasChildren(['date','ts','amount','expenseCount','total'])",
              "date": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
              },
              "expenseCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
              },
              "total": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
              },
              "debtorName": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "inviteCode": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $owner",
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
        },
        "partner": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((!newData.exists() && auth.uid == $owner) || (newData.child('uid').val() == auth.uid && auth.uid != $owner && ((!data.exists() && root.child('invitations').child(newData.child('inviteCode').val()).child('ownerUid').val() == $owner && root.child('invitations').child(newData.child('inviteCode').val()).child('expiresAt').val() > now && root.child('spaces').child($owner).child('inviteCode').val() == newData.child('inviteCode').val()) || (data.child('uid').val() == auth.uid && newData.child('inviteCode').val() == data.child('inviteCode').val()))))",
          ".validate": "newData.hasChildren(['uid','inviteCode'])",
          "uid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "inviteCode": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "invitations": {
      "$code": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((!data.exists() && newData.child('ownerUid').val() == auth.uid && root.child('spaces').child(auth.uid).child('data/config').exists() && !root.child('spaces').child(auth.uid).child('partner').exists()) || (data.child('ownerUid').val() == auth.uid && !newData.exists()))",
        ".validate": "$code.matches(/^[a-f0-9]{32}$/) && newData.hasChildren(['ownerUid','expiresAt'])",
        "ownerUid": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 691200000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
